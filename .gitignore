# Виртуальное окружение и кэш интерпретатора.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Сборка колеса. Каталог dist/ создаёт uv build, в git он не нужен.
build/
dist/

# Служебные файлы macOS и Jupyter.
.DS_Store
.ipynb_checkpoints/

# Прогоны обучения: конфиг копии, история, чекпоинты, логи.
/runs/
/logs/
/checkpoints/
*.pt
*.pth
*.log

# Датасет и собранное C++ расширение. Оба ставятся локально и в пакет не входят.
**/VessMAP/
/Betti-Matching-3D/

# Кэш локальной компиляции cubical_betti.c. В колесе лежит исходник, не библиотека.
.cache/
*.dylib
*.so

# Редакторы и покрытие тестов.
.idea/
.vscode/
.coverage
htmlcov/

# Обучение, тесты и заметки разработчика. Пользователю пакета они не нужны.
/experiments/
/configs/
/splits/
/tests/
/train.py
/run_full_pipeline.py
/Hubs.md
/RELEASING.md
/uv.lock
/.python-version
